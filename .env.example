# =====================================================================
# AISensorEdgeComp Platform — environment variables
# Copy to .env and adjust as needed. Never commit .env.
# =====================================================================

# ─── General ──────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=aisensoredgecomp-platform

# ─── MQTT (ingest) ─────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=aisensor/telemetry
MQTT_QOS=1
MQTT_KEEPALIVE=60

# ─── Kafka (stream) ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=telemetry.raw
KAFKA_TOPIC_ALERTS=alerts.processed
KAFKA_TOPIC_ASSETS=assets.events
KAFKA_TOPIC_MAINTENANCE=maintenance.events
KAFKA_SCHEMA_REGISTRY=http://localhost:8081
KAFKA_CLIENT_ID=aisensoredgecomp-ingest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ─── TimescaleDB (hot storage) ──────────────────────────────────────
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=aisensoredgecomp
TIMESCALE_USER=aisensoredgecomp
TIMESCALE_PASSWORD=changeme
TIMESCALE_SSLMODE=disable

# ─── Iceberg (cold storage) ────────────────────────────────────────
ICEBERG_REST_CATALOG=http://localhost:8181
ICEBERG_WAREHOUSE=s3://aisensoredgecomp-warehouse
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1

# ─── ClickHouse (OLAP) ─────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=aisensoredgecomp

# ─── Flink (stream processing) ─────────────────────────────────────
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081
FLINK_PARALLELISM=4
FLINK_CHECKPOINT_INTERVAL_MS=60000
FLINK_STATE_BACKEND=rocksdb

# ─── ML inference service ──────────────────────────────────────────
ML_MODEL_PATH=./ml/models/ts-fm-v1.onnx
ML_DEVICE=cuda  # or cpu
ML_BATCH_SIZE=32
ML_MAX_LATENCY_MS=100
ML_TS_FM_CONFIDENCE_THRESHOLD=0.85

# ─── API server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_RATE_LIMIT_PER_MIN=1000

# ─── Auth (JWT) ────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── Observability ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ─── Compliance ────────────────────────────────────────────────────
DATA_RESIDENCY_REGION=us
ENABLE_AUDIT_LOG=true
ENCRYPTION_AT_REST=true
